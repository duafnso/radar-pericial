++
++    function handleKeyDown(event: KeyboardEvent) {
++      if (event.key === "Escape") {
++        event.preventDefault();
++        closeRef.current();
++        return;
++      }
++      if (event.key !== "Tab") return;
++
++      const elements = focusableElements();
++      if (!elements.length) {
