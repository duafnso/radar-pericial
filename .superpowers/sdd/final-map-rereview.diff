+        assert "ORDER BY sp.calculado_em DESC NULLS LAST, sp.id DESC" in sql
+        assert sql.count("LIMIT 1") == 1
+        assert "LEFT JOIN score_pericial s ON s.processo_id = p.id" not in sql
