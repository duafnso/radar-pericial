# Runtime
APP_ENV=development
LOG_LEVEL=info
WEB_WORKERS=2
WORKER_CONCURRENCY=2
WORKER_TIME_LIMIT=3600
PYTHONPATH=/app

# Map tiles (public build-time values; provider changes require a Docker rebuild)
VITE_MAP_TILE_URL=
VITE_MAP_TILE_ATTRIBUTION=

# API
CORS_ALLOW_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
ENABLE_API_DOCS=true
SECRET_KEY=change-me-in-production
SESSION_TOKEN_PEPPER=change-me-in-production
DEFAULT_ADMIN_PASSWORD=change-me-local-admin-password
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300
RESET_DEFAULT_ADMIN_PASSWORD=false
RATE_LIMIT_BACKEND=memory
SENSITIVE_ACTION_MAX_ATTEMPTS=20
SENSITIVE_ACTION_WINDOW_SECONDS=300

# Database
DATABASE_URL=postgresql://radar:radar123@db:5432/radar_pericial
PGHOST=db
PGPORT=5432
PGUSER=radar
PGPASSWORD=radar123
PGDATABASE=radar_pericial

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# Data sources
DATAJUD_API_KEY=
ENABLE_SOURCE_DATAJUD=true
ENABLE_SOURCE_DJE=false
ENABLE_SOURCE_DOU=true
ENABLE_SOURCE_IOMAT=false
ENABLE_SOURCE_DNIT=true
ENABLE_SOURCE_SINFRA=false
ENABLE_SOURCE_IBGE_MUNICIPIOS=true
ENABLE_SOURCE_IBGE_ESTADO=true
ENABLE_SOURCE_IBGE_INFO=true
ENABLE_SOURCE_SIGEF=false
ENABLE_SOURCE_ASSENTAMENTOS=false
ENABLE_SOURCE_PRODES=true
ENABLE_SOURCE_DETER=false
ENABLE_SOURCE_CAR=false
ALLOW_INSECURE_CAR_SSL=false

# Collection tuning
DATAJUD_START_DATE=2026-01-01
DATAJUD_PAGE_SIZE=50
DATAJUD_MAX_RESULTS_PER_CLASS=500
DATAJUD_REQUEST_DELAY_SECONDS=8
DATAJUD_429_COOLDOWN_SECONDS=90
DATAJUD_MAX_429_RETRIES=1
DATAJUD_CLASSES_LIMIT=7
DATAJUD_INCREMENTAL_OVERLAP_DAYS=3
LOAD_DEMO_DATA=false

# Retention
AUDIT_RETENTION_DAYS=365
COLLECTION_RETENTION_DAYS=180
COLLECTION_METRICS_RETENTION_DAYS=180

# Alert delivery
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WEBHOOK_ALERT_URL=


