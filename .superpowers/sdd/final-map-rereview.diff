+                FROM processos p
+                LEFT JOIN LATERAL (
+                    SELECT sp.score_total, sp.faixa_probabilidade
+                    FROM score_pericial sp
+                    WHERE sp.processo_id = p.id
+                    ORDER BY sp.calculado_em DESC NULLS LAST, sp.id DESC
+                    LIMIT 1
