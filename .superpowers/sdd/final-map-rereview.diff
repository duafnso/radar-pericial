+        limit_cidades=100,
+    )
+
+    assert result["total_processos"] == 702
+    assert result["sem_localizacao"] == 27
+    assert result["total_municipios"] == 73
+    assert result["items"][0]["total_processos"] == 152
+    items_sql, items_params = calls[0]
