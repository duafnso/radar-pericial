{
  "scripts": {
    "frontend:dev": "vite --host 0.0.0.0",
    "frontend:test": "npm run frontend:test:contracts && npm run frontend:test:behavior",
    "frontend:build": "vite build && node frontend/scripts/sync-build.mjs",
    "frontend:preview": "vite preview --host 0.0.0.0",
    "frontend:test:contracts": "node --experimental-strip-types --test frontend/tests/*.test.mjs",
    "frontend:test:behavior": "vitest run --config frontend/vitest.config.ts",
    "frontend:typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "leaflet": "1.9.4",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/leaflet": "1.9.21",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^26.1.0",
    "vitest": "^3.2.7"
  },
  "type": "module"
}
